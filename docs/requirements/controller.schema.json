{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Reference controller independently declared requirements",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "assumptions",
    "bounds",
    "codec_version",
    "coverage_targets",
    "input_domains",
    "model",
    "mutations",
    "properties",
    "properties_version",
    "regression_corpus",
    "required_search_outcome",
    "review",
    "schema_version"
  ],
  "properties": {
    "properties": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "input_domains": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true
      }
    },
    "bounds": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "integer",
        "minimum": 1
      }
    },
    "mutations": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "schema_version": {
      "const": 1
    },
    "codec_version": {
      "type": "integer",
      "minimum": 1
    },
    "properties_version": {
      "type": "integer",
      "minimum": 1
    },
    "model": {
      "type": "string",
      "minLength": 1
    },
    "regression_corpus": {
      "type": "string",
      "minLength": 1
    },
    "coverage_targets": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "assumptions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "required_search_outcome": {
      "enum": [
        "graph_exhausted",
        "cases_completed"
      ]
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reviewer"
      ],
      "properties": {
        "status": {
          "enum": [
            "awaiting_independent_review",
            "independently_reviewed"
          ]
        },
        "reviewer": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
