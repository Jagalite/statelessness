      "command": [
        "/Volumes/seed1/Projects/stateless-abi-v2-packaging-venv/bin/python",
        "-c",
        "from pathlib import Path\nimport hashlib, json, tarfile, zipfile, importlib.metadata, subprocess\nroot=Path.cwd(); bundle=root/\"target/bindings\"\ndef digest(data): return hashlib.sha256(data).hexdigest()\ndef sha(path): return digest(path.read_bytes())\nmanifest=json.loads((bundle/\"manifest-all.json\").read_text())\nfor name, expected in manifest[\"files\"].items():\n    assert sha(bundle/name)==expected, name\narchives={}\nnpm=list((bundle/\"browser-dist\").glob(\"*.tgz\"))\nassert len(npm)==1\nwith tarfile.open(npm[0],\"r:gz\") as archive:\n    members=[m for m in archive.getmembers() if m.isfile()]\n    names=[m.name for m in members]; assert len(names)==len(set(names))\n    files={m.name.removeprefix(\"package/\"):digest(archive.extractfile(m).read()) for m in members}\n    expected={p.relative_to(bundle/\"browser\").as_posix():sha(p) for p in (bundle/\"browser\").rglob(\"*\") if p.is_file()}\n    assert files==expected, \"npm archive differs from staged browser package\"\narchives[\"npm\"]={\"path\":str(npm[0].relative_to(root)),\"sha256\":sha(npm[0]),\"files\":files}\nwheels=list((bundle/\"python-dist\").glob(\"*.whl\"));assert len(wheels)==1\nwith zipfile.ZipFile(wheels[0]) as archive:\n    names=archive.namelist();assert len(names)==len(set(names))\n    files={name:digest(archive.read(name)) for name in names if not name.endswith(\"/\")}\n    source=bundle/\"python/src\"\n    expected={p.relative_to(source).as_posix():sha(p) for p in source.rglob(\"*\") if p.is_file()}\n    assert all(files.get(name)==value for name,value in expected.items()), \"wheel source differs from stage\"\n    assert set(expected)=={name for name in files if name.startswith(\"statelessness/\")}\n    for name in (\"native.py\",\"_native_packet.py\",\"native_conformance.py\",\"trace_json.py\",\"py.typed\"):\n        assert \"statelessness/\"+name in files\narchives[\"wheel\"]={\"path\":str(wheels[0].relative_to(root)),\"sha256\":sha(wheels[0]),\"files\":files}\nreport={\"schema\":\"stateless.archive-inspection.v1\",\"source_sha256\":manifest[\"build\"][\"source\"][\"sha256\"],\"manifest_sha256\":sha(bundle/\"manifest-all.json\"),\"outcome\":\"passed_for_requested_scope\",\"scope\":\"Static archive file inventories and hashes only; package engines are not imported or instantiated.\",\"archive_files\":archives,\"build_dependencies\":{name:importlib.metadata.version(name) for name in (\"pip\",\"setuptools\",\"wheel\",\"packaging\")},\"node\":subprocess.check_output([\"node\",\"--version\"],text=True).strip(),\"npm\":subprocess.check_output([\"npm\",\"--version\"],text=True).strip(),\"runtime_tests\":\"not_run\",\"benchmark_measurements\":\"not_run\"}\n(root/\"validation/abi-v2/archive-inspection.json\").write_text(json.dumps(report,indent=2,sort_keys=True)+\"\\n\")\nprint(\"Static archive inspection passed:\",[(k,v[\"sha256\"]) for k,v in archives.items()])\n"
